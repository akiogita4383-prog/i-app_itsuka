{
  "name": "itsuka",
  "version": "1.0.0",
  "private": true,
  "description": "いつか帳 iOSアプリ（Capacitor）",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "sync": "node scripts/vendor.mjs && cap sync ios",
    "open": "cap open ios",
    "xcode:setup": "ruby scripts/setup-xcode.rb",
    "build:web": "node scripts/vendor.mjs && node scripts/build-web.mjs",
    "assets": "node scripts/make-assets.mjs",
    "serve": "npx --yes http-server www -p 8787 -c-1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/text-zoom": "^8.0.1",
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.35.5"
  }
}
